{
  "name": "desafio-color-bms",
  "private": true,
  "type": "module",
  "description": "Color financial management system (local web app)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm run dev -w @color-bms/server\" \"npm run dev -w @color-bms/web\"",
    "build": "npm run build -w @color-bms/web && npm run build -w @color-bms/server",
    "start": "node apps/server/dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test"
  },
  "allowScripts": {
    "esbuild": true,
    "@swc/core": true,
    "better-sqlite3": false
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "prettier": "^3.10.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "vite": "^5.4.21"
  }
}
